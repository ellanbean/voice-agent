# ---- LiveKit Cloud (Settings → API Keys → create key; secret is shown once) ----
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=sales-caller

# ---- SIP trunks, primary first. IDs from: lk sip outbound create sip/<file>.json ----
# Zadarma only today. With a second carrier: SIP_OUTBOUND_TRUNK_IDS=ST_zadarma,ST_route2
SIP_OUTBOUND_TRUNK_IDS=

# ---- Speech ----
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
# Voice rotation: Name:voice_id pairs; each lead is assigned one (stable across retries) and it is recorded on the call.
IVR_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # hold-line voice (female, multilingual) — ElevenLabs "Sarah"
HOLD_MAX_SECONDS=300
TRANSFER_RING_SECONDS=40
ELEVEN_VOICES=Daniel:onwK4e9ZLuTAKqWW03F9,Adam:pNInz6obpgDQGcFmaJgB,George:JBFqnCBsd6RMkjVDRZzb

# ---- Interpreter (real-time two-way translation on human handovers) ----
INTERPRETER_ENABLED=1
INTERPRETER_AGENT_NAME=interpreter
INTERP_STT=deepgram              # deepgram | whisper  (whisper = self-hosted interp_server on RunPod)
INTERP_MT=auto                   # auto | deepl | nllb | llm   (auto: DeepL if key+languages, else NLLB if INTERP_SERVER_URL, else Hermes)
INTERP_TTS=elevenlabs            # elevenlabs | piper  (piper = self-hosted interp_server)
# DEEPL_API_KEY=                 # optional; free keys end in :fx. No Hindi on DeepL → hi legs use the LLM automatically
# INTERP_SERVER_URL=http://IP:PORT   # optional: interp_server (faster-whisper + NLLB + Piper) pod on RunPod
INTERP_VOICE_TO_CUSTOMER=nPczCjzI2devNBz1zQrb   # ElevenLabs "Brian": the human agent's translated voice (deliberately not Daniel)
INTERP_VOICE_TO_AGENT=Xb7hH8MSUJpSbSDYk0k2      # ElevenLabs "Alice": the customer's translated voice the agent hears
INTERP_ENDPOINTING_MS=300        # silence that ends a clause; lower = faster but choppier
INTERP_EARCON=1                  # soft tick for the listener when a translation is coming late
INTERP_MERGE_BACKLOG=3           # merge up to N queued segments into one synthesis when falling behind

# ---- LLM on RunPod ----
RUNPOD_API_KEY=
RUNPOD_POD_ID=mnp8qbabtjkxpf
VLLM_API_KEY=87e377a54691f28b37e75ccfd4b2d668e0264158f5f7f039
VLLM_MODEL=NousResearch/Hermes-4-70B-FP8
# VLLM_BASE_URL=http://IP:PORT/v1      # optional: pin instead of resolving the pod's port live
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=160

# ---- Supabase (Project Settings → API: URL + service_role key; server-side only) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Web app ----
WEB_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---- Dialer ----
MAX_CONCURRENT_CALLS=5
CALLS_PER_MINUTE=6
CALLING_HOURS=09:00-20:00
CALLING_DAYS=1-6
# DIALER_COUNTRIES=GB,DE               # optional: restrict a run to these countries

# ---- Zadarma balance alert (my.zadarma.com/api/) ----
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
ZADARMA_MIN_BALANCE=20
# ALERT_WEBHOOK_URL=https://n8n.yourdomain/webhook/alerts

# ---- Local transcript copies (Supabase is the system of record) ----
TRANSCRIPT_DIR=transcripts
# TRANSCRIPT_WEBHOOK_URL=
